{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "strict": true,
        "noImplicitOverride": true,
        "noUncheckedIndexedAccess": true,
        "declaration": true,
        "sourceMap": false,
        "outDir": "dist/esm",
        "rootDir": "src",
        "skipLibCheck": true
    },
    "include": ["src"]
}
